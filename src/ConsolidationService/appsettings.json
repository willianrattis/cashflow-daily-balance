{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplyMigrationsOnStartup": false,
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "RetryDelaysMs": [5000, 30000, 120000]
  },
  "Jwt": {
    "Issuer": "cashflow-dev-issuer",
    "Audience": "cashflow-api"
  },
  "RateLimiting": {
    "ReadRequestsPerSecond": 500
  }
}
