{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplyMigrationsOnStartup": false,
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalMs": 500,
    "PublishTimeoutMs": 5000
  },
  "Jwt": {
    "Issuer": "cashflow-dev-issuer",
    "Audience": "cashflow-api"
  },
  "RateLimiting": {
    "WriteRequestsPerSecond": 100,
    "ReadRequestsPerSecond": 500
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  }
}
